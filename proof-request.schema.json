{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "subject": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "app_url": {
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "head"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "agent_message",
            "commit",
            "pr_body",
            "plan",
            "file"
          ]
        },
        "text": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "hash"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "browser",
              "command",
              "human"
            ]
          },
          "check": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "setup": {
                "type": "string"
              },
              "command": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "verdict": {
            "type": "string",
            "enum": [
              "held",
              "broken",
              "needs_human",
              "unverified"
            ]
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "observed": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "screenshot",
                    "assertion",
                    "http",
                    "console",
                    "command",
                    "note"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "step": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "text": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "method": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "status": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "level": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "exit_code": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "stdout": {
                  "type": "string"
                },
                "stderr": {
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "tester": {
            "type": "string"
          },
          "judge": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "cached": {
            "type": "boolean"
          },
          "assignee": {
            "type": [
              "string",
              "null"
            ]
          },
          "signoff": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "by": {
                    "type": "string"
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "accepted",
                      "rejected"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  }
                },
                "required": [
                  "by",
                  "decision",
                  "at"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "verdict"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "held": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "broken": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "needs_human": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "unverified": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "held",
        "broken",
        "needs_human",
        "unverified"
      ],
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "prq-claims/v1"
        },
        "task": {
          "type": "string"
        },
        "unfinished": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "format",
        "unfinished"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "diff_url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openai",
            "openrouter"
          ]
        },
        "model": {
          "type": "string"
        },
        "judge_model": {
          "type": "string"
        },
        "decision_mode": {
          "type": "string",
          "enum": [
            "decisions",
            "structured"
          ]
        }
      },
      "required": [
        "provider",
        "model",
        "judge_model"
      ],
      "additionalProperties": false
    },
    "model_usage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "extraction",
              "classification",
              "judge",
              "browser"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "openrouter"
            ]
          },
          "model": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "unavailable",
              "external"
            ]
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "stage",
          "provider",
          "model",
          "status",
          "input_tokens",
          "output_tokens",
          "cost_usd"
        ],
        "additionalProperties": false
      }
    },
    "timing": {
      "type": "object",
      "properties": {
        "total_ms": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reported_cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "created_at",
    "subject",
    "source",
    "claims",
    "summary"
  ],
  "additionalProperties": false
}
