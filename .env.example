# Choose one provider. Never commit a populated .env file.
# Direct OpenAI defaults to gpt-6.1-sol.
OPENAI_API_KEY=

# Or use OpenRouter with an explicit model available to your account.
# PRQ_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# PRQ_MODEL=provider/model-id
# Structured mode judge defaults to PRQ_MODEL; OpenAI Decisions defaults to gpt-6-luna.
# PRQ_JUDGE_MODEL=provider/model-id

# Optional. Start the application separately; this is its running URL.
# PRQ_APP_URL=http://localhost:3000

# OpenAI keeps Decisions by default. Opt into structured judgment explicitly:
# PRQ_DECISION_MODE=structured
